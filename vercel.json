{
  "version": 2,
  "headers": [{
    "source": "/chat-preview/(.*)",
    "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "https://speakdobre.webflow.io" },
      { "key": "Cache-Control", "value": "no-cache" }
    ]
  }, {
    "source": "/chat-production/(.*)",
    "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "https://www.speakdobre.com" },
      { "key": "Cache-Control", "value": "no-cache" }
    ]
  }]
}
